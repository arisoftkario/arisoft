rules_version = '2';

// À copier dans la console Firebase : Firestore Database > Règles > Publier.
service cloud.firestore {
  match /databases/{database}/documents {

    // Un admin = un utilisateur connecté dont l'UID existe dans la collection « admins ».
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Jusqu'à 4 photos et un lien vidéo (TikTok, YouTube, Facebook).
    function isValidMedia(d) {
      return d.images is list && d.images.size() <= 4
        && d.videoUrl is string && d.videoUrl.size() <= 500;
    }

    // Visiteurs : seul le compteur « likes » peut changer, d'exactement +1 ou -1.
    // (les publications sans compteur partent de 0)
    function isLikeChange() {
      let before = resource.data.get('likes', 0);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && (request.resource.data.likes == before + 1
          || request.resource.data.likes == before - 1)
        && request.resource.data.likes >= 0;
    }

    function isValidProject() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 150
        && d.clientName is string && d.clientName.size() <= 150
        && d.serviceCategory is string && d.serviceCategory.size() <= 100
        && d.description is string && d.description.size() <= 2000
        && d.imageUrl is string
        && isValidMedia(d);
    }

    // Réalisations : lecture publique, « J'aime » pour tous, le reste réservé aux admins.
    match /realisations/{projectId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProject();
      allow update: if (isAdmin() && isValidProject()) || isLikeChange();
      allow delete: if isAdmin();
    }

    function isValidAd() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.description is string && d.description.size() <= 1500
        && d.badge is string && d.badge.size() <= 20
        && d.imageUrl is string
        && isValidMedia(d)
        && d.likes is int;
    }

    // Publicités : lecture publique, « J'aime » pour tous, le reste réservé aux admins.
    match /publicites/{adId} {
      allow read: if true;
      allow create: if isAdmin() && isValidAd() && request.resource.data.likes == 0;
      allow update: if (isAdmin() && isValidAd()) || isLikeChange();
      allow delete: if isAdmin();
    }

    function isValidTestimonial() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'company', 'rating', 'message', 'approved', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.company is string && d.company.size() <= 100
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.message is string && d.message.size() >= 10 && d.message.size() <= 1000
        && d.approved is bool;
    }

    // Avis clients : n'importe qui peut en envoyer un (en attente), seul un admin le publie.
    match /avis/{avisId} {
      allow read: if resource.data.approved == true || isAdmin();
      allow create: if isValidTestimonial()
        && request.resource.data.approved == false
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && isValidTestimonial()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved']);
      allow delete: if isAdmin();
    }

    // Commentaires : publiés directement par les visiteurs, supprimables par les admins.
    match /commentaires/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['targetType', 'targetId', 'name', 'message', 'createdAt'])
        && request.resource.data.targetType in ['publicites', 'realisations']
        && request.resource.data.targetId is string
        && exists(/databases/$(database)/documents/$(request.resource.data.targetType)/$(request.resource.data.targetId))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
    }

    // Abonnés aux notifications : chaque navigateur s'inscrit lui-même ;
    // seul un admin peut lire la liste (envoi) et supprimer les abonnements expirés.
    match /abonnes/{subscriptionId} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['endpoint', 'p256dh', 'auth', 'createdAt'])
        && request.resource.data.endpoint is string
        && request.resource.data.endpoint.matches('https://.+')
        && request.resource.data.endpoint.size() <= 1000
        && request.resource.data.p256dh is string && request.resource.data.p256dh.size() <= 200
        && request.resource.data.auth is string && request.resource.data.auth.size() <= 100
        && request.resource.data.createdAt == request.time;
    }

    // Catalogue des prestations : lecture publique, modification réservée aux admins.
    function isValidService() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'slug', 'shortDescription', 'fullDescription', 'iconName', 'features', 'ctaLabel', 'order'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.slug is string && d.slug.size() > 0 && d.slug.size() <= 80
        && d.shortDescription is string && d.shortDescription.size() <= 300
        && d.fullDescription is string && d.fullDescription.size() <= 2000
        && d.iconName is string && d.iconName.size() <= 40
        && d.features is list && d.features.size() <= 8
        && d.ctaLabel is string && d.ctaLabel.size() <= 80
        && d.order is int;
    }

    match /catalogue/{serviceId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidService();
      allow delete: if isAdmin();
    }

    // Entreprises qui font confiance à ARISOFT (logos).
    function isValidClient() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'activity', 'location', 'logo', 'order'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.activity is string && d.activity.size() <= 100
        && d.location is string && d.location.size() <= 100
        && d.logo is string && d.logo.size() <= 150000
        && d.order is int;
    }

    match /clients/{clientId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidClient();
      allow delete: if isAdmin();
    }

    // Photos des services : lecture publique, écriture réservée aux admins.
    // « services » = miniature légère de l'accueil ; « servicesMedias » = photos complètes et vidéo.
    match /services/{serviceId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['cover', 'updatedAt'])
        && request.resource.data.cover is string
        && request.resource.data.cover.size() <= 100000;
      allow delete: if isAdmin();
    }

    match /servicesMedias/{serviceId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['images', 'videoUrl', 'updatedAt'])
        && isValidMedia(request.resource.data);
      allow delete: if isAdmin();
    }

    // Liste des admins : gérée uniquement depuis la console Firebase.
    match /admins/{uid} {
      allow read, write: if false;
    }
  }
}
