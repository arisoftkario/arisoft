# Copiez ce fichier en .env.local puis renseignez les valeurs de votre projet Firebase
# (Console Firebase > Paramètres du projet > Vos applications > Application Web > Configuration).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Search Console > Ajouter une propriété > Préfixe d'URL > Balise HTML : coller seulement la valeur de content="..."
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
